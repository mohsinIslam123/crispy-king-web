backend:
  name: git-gateway
  branch: main

media_folder: "static/uploads"
public_folder: "/uploads"

# ─── EDITOR SETTINGS ──────────────────────────────────────────────────────────
locale: "en"
show_preview_links: true

# ─── MENU COLLECTIONS ─────────────────────────────────────────────────────────
# Each category = one JSON file at content/menu/{slug}.json
# The list widget saves items as an array → menu-loader.js reads data.items[]
collections:

  - name: "veg-burgers"
    label: "🥬 Veg Burgers"
    format: "json"
    files:
      - name: "veg-burgers"
        label: "Veg Burgers"
        file: "content/menu/veg-burgers.json"
        fields:
          - label: "Items"
            name: "items"
            widget: "list"
            summary: "{{fields.name}} — ₹{{fields.price}}"
            fields:
              - { label: "Name",        name: "name",        widget: "string" }
              - { label: "Description", name: "description", widget: "text",   required: false }
              - { label: "Price (₹)",   name: "price",       widget: "number", value_type: "int" }
              - { label: "Image",       name: "image",       widget: "image",  required: false, hint: "Leave blank to show emoji fallback" }
              - { label: "Badge",       name: "badge",       widget: "string", required: false, hint: "e.g. Best Seller, New, Spicy" }
              - { label: "Is Veg",      name: "isVeg",       widget: "boolean", default: true }

